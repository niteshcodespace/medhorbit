# Local development database (see ../docker-compose.yml). Server-only: never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://medhorbit:medhorbit_dev@localhost:5433/medhorbit

# Better Auth (Phase 9D). Server-only: never use a NEXT_PUBLIC_ prefix.
# Random 32+ byte secret used to sign sessions and encrypt OAuth tokens
# at rest (see account.encryptOAuthTokens). Generate a real value per
# environment; never reuse the same secret between dev and production.
BETTER_AUTH_SECRET=
# Base URL Better Auth uses to build OAuth callback URLs, e.g.
# http://localhost:3000 in local development.
BETTER_AUTH_URL=
# Google OAuth client credentials (Phase 9D-1B). Not yet used - the
# Google provider is not wired up in Phase 9D-1A.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
